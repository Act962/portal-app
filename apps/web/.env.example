# Copie para .env e ajuste o que precisar:
#   cp apps/web/.env.example apps/web/.env
#
# Os valores abaixo funcionam direto com o `pnpm db:start`, sem conta em
# nenhum serviço externo.

# Banco. Usuário, senha e database batem com packages/db/docker-compose.yml.
# Se a 5432 já estiver ocupada na sua máquina, defina POSTGRES_PORT em
# packages/db/.env e use a mesma porta aqui.
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_app?schema=public"

# Cache Redis (container do `pnpm db:start`). Ainda sem consumidor — passa a ser
# usado a partir da Fase 4. Ajuste a porta se tiver definido REDIS_PORT.
REDIS_URL="redis://localhost:6379"

# Autenticação (Better-Auth).
# Gere um segredo próprio — mínimo de 32 caracteres:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-de-no-minimo-32-caracteres"
BETTER_AUTH_URL="http://localhost:3001"

# Origem permitida pelo CORS e pelos trustedOrigins do Better-Auth.
CORS_ORIGIN="http://localhost:3001"

# Armazenamento de mídia (S3-compatível). Os defaults abaixo miram o MinIO do
# `pnpm db:start` (bucket `portal-media` criado automaticamente), então dá para
# subir imagem sem configurar nada.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="portal-media"
S3_PUBLIC_URL="http://localhost:9000/portal-media"
S3_FORCE_PATH_STYLE="true"

# Em PRODUÇÃO, aponte para o Cloudflare R2 — o mesmo adapter serve os dois
# (ADR 0009), não há código a mudar. Ver docs/deploy.md §2.
#
#   S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#   S3_ACCESS_KEY_ID="<do token do R2>"       ← nunca comite este valor
#   S3_SECRET_ACCESS_KEY="<do token do R2>"   ← nunca comite este valor
#   S3_BUCKET="portal-media"
#   S3_PUBLIC_URL="https://pub-d14859754dc2458b927087bc10b1e102.r2.dev"
#   S3_FORCE_PATH_STYLE="false"               ← o R2 usa virtual-hosted style
#
# A S3_PUBLIC_URL é o prefixo das imagens na leitura: o banco guarda só a chave
# do arquivo, e a URL é montada como `${S3_PUBLIC_URL}/${chave}`. As capas do
# `pnpm db:seed` vivem no bucket acima, então só aparecem com esta variável
# apontando para lá.
