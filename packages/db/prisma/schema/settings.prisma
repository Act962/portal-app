/// Configuração do veículo — LINHA ÚNICA (docs/specs/05b, D6).
///
/// O `id` tem default fixo e é a chave primária: a unicidade é do banco, não de
/// uma convenção do código. Não há "pega o primeiro", não há como nascer uma
/// segunda linha por corrida.
///
/// Linha ausente é estado válido: o agregado cai nos defaults (D7), então um
/// banco recém-migrado já serve o portal inteiro.
model SiteSettings {
  id String @id @default("singleton")

  // Identidade
  name        String
  shortName   String
  tagline     String
  description String
  url         String
  city        String
  state       String
  logoMediaId String?

  // Ícone da aba do navegador. Coluna própria, e não o `logoMediaId` reusado:
  // o logo é horizontal e legível a 200px, o favicon é quadrado e precisa
  // funcionar a 16px. Servir um como o outro borra em algum dos dois lugares.
  faviconMediaId String?

  // Rádio (D11) — só a identidade que o portal exibe. O `radioStreamUrl` saiu
  // junto com o player de áudio: a transmissão ao vivo deixou de fazer parte do
  // produto.
  radioFrequency String?
  radioBand      String?

  // Contato
  contactNewsroom String?
  contactWhatsapp String?
  contactEmail    String?
  contactAddress  String?

  /// Listas curtas, ordenadas, editadas inteiras e nunca consultadas por item
  /// (D13). Normalizar custaria três modelos e três CRUDs para nada.
  social          Json
  institutional   Json
  popularSearches Json

  legal String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
