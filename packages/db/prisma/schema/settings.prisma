/// Configuração do veículo — LINHA ÚNICA (docs/specs/05b, D6).
///
/// O `id` tem default fixo e é a chave primária: a unicidade é do banco, não de
/// uma convenção do código. Não há "pega o primeiro", não há como nascer uma
/// segunda linha por corrida.
///
/// Linha ausente é estado válido: o agregado cai nos defaults (D7), então um
/// banco recém-migrado já serve o portal inteiro.
model SiteSettings {
  id String @id @default("singleton")

  // Identidade
  name        String
  shortName   String
  tagline     String
  description String
  url         String
  city        String
  state       String
  logoMediaId String?

  // Ícone da aba do navegador. Coluna própria, e não o `logoMediaId` reusado:
  // o logo é horizontal e legível a 200px, o favicon é quadrado e precisa
  // funcionar a 16px. Servir um como o outro borra em algum dos dois lugares.
  faviconMediaId String?

  // A arte do compartilhamento (`og:image`, spec 07). Terceira coluna de imagem
  // pela mesma razão da segunda: a caixa aqui é 1200×630, e o logo horizontal
  // nela sai esticado ou entre faixas. Nulo é normal — sem arte, o portal gera
  // um cartão com o título da página.
  ogImageMediaId String?

  /// O bloco CONTATO do rodapé: uma linha de texto livre por item, em ordem.
  /// Substitui os quatro campos fixos abaixo — lista vazia é resposta válida,
  /// e era justamente o que eles não sabiam guardar.
  contactLines Json @default("[]")

  // LEGADO — nenhum código lê nem escreve mais. A rádio saiu do produto e o
  // contato virou `contactLines` (migration `20261009120000_contact_lines`, que
  // copia os valores para lá). As colunas ficam por UM deploy: a migração roda
  // antes de a imagem nova entrar no ar, e derrubá-las já quebraria a versão
  // que ainda está respondendo. Remover numa migração seguinte
  // (docs/pendencias.md).
  radioFrequency  String?
  radioBand       String?
  contactNewsroom String?
  contactWhatsapp String?
  contactEmail    String?
  contactAddress  String?

  /// Listas curtas, ordenadas, editadas inteiras e nunca consultadas por item
  /// (D13). Normalizar custaria três modelos e três CRUDs para nada.
  social          Json
  institutional   Json
  popularSearches Json

  /// A frase do rodapé, abaixo da marca (D2 do cliente, 08/09).
  ///
  /// Coluna própria, e não `tagline` reaproveitada: a tagline é identidade —
  /// vai para `og:site_name`, para o cabeçalho e para o schema.org, em caixa
  /// alta e curta. Esta é COPY: uma frase inteira, com pontuação, que a redação
  /// troca quando quiser sem mexer no que os buscadores leem. Servir uma como a
  /// outra estraga alguma das duas.
  ///
  /// Nulo cai no default do domínio, que é a frase em uso hoje.
  footerTagline String?

  legal String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
