/// Convite para entrar na redação (spec 05, D2).
///
/// O id é o token opaco do link. Convites nominais também validam `email`;
/// convites abertos reservam `claimedEmail` para o primeiro cadastro. A exceção
/// é o primeiro usuário do sistema, que nasce ADMIN.
model Invitation {
  id String @id @default(cuid())

  /// Sempre em minúsculas e aparado: é chave de comparação com o e-mail do
  /// cadastro, e "Joao@X.com" precisa casar com "joao@x.com".
  email String?

  /// Primeiro e-mail que apresentou o token. Torna o consumo de link aberto
  /// atômico e permite retomar o cadastro com o mesmo endereço.
  claimedEmail String?

  role       String
  /// Editorias às quais o membro fica vinculado ao aceitar (EDITOR).
  sectionIds String[] @default([])

  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String

  createdAt DateTime @default(now())

  /// A consulta do portão: o convite aberto de um e-mail, em todo cadastro.
  @@index([email, acceptedAt])
  @@index([claimedEmail, acceptedAt])
  @@map("invitation")
}
