// Contexto de Mídia (Fase 2).
//
// Metadados do arquivo; o binário mora no storage (R2/MinIO), referenciado por
// storageKey (único). Dimensões e ponto focal são achatados em colunas anuláveis
// — só imagem os tem. Independente do Editorial (o vínculo com Article é da
// Fase 3). Id gerado na aplicação; o @default(cuid()) é conveniência de seed.

model MediaAsset {
  id         String  @id @default(cuid())
  type       String
  storageKey String  @unique
  filename   String
  mimeType   String
  caption    String  @default("")
  credit     String
  altText    String?
  width      Int?
  height     Int?
  focalX     Float?
  focalY     Float?

  // Pasta onde o arquivo está. Nulo é estado VÁLIDO: "sem pasta" (D2).
  //
  // `Restrict` é a SEGUNDA linha de defesa do invariante "pasta com arquivo não
  // se exclui" (D3): mesmo que a regra da aplicação falhe, ou alguém apague
  // direto no banco, o Postgres recusa.
  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@map("media_asset")
}

// Pastas da biblioteca (spec 06, D1). PLANAS — sem `parentId`, sem caminho.
model MediaFolder {
  id   String @id @default(cuid())
  // O nome é a identidade para quem usa; duas "Eleições 2026" não ajudam.
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets MediaAsset[]

  @@map("media_folder")
}
