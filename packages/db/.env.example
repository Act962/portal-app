# Lido automaticamente pelo Docker Compose (mesmo diretório do compose file).
# Copie para .env apenas se precisar mudar algo:
#   cp packages/db/.env.example packages/db/.env
#
# Só é necessário quando a porta padrão já está ocupada por outro Postgres na
# máquina. Se mudar aqui, mude também a porta da DATABASE_URL em apps/web/.env.

POSTGRES_PORT=5432
