# Lido automaticamente pelo Docker Compose (mesmo diretório do compose file).
# Copie para .env apenas se precisar mudar algo:
#   cp packages/db/.env.example packages/db/.env
#
# Só é necessário quando uma porta padrão já está ocupada por outro serviço na
# máquina. Se mudar o Postgres aqui, mude também a porta da DATABASE_URL em
# apps/web/.env; idem para o Redis (REDIS_URL), quando houver consumidor.

POSTGRES_PORT=5432
REDIS_PORT=6379
