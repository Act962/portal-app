{
  "name": "portal-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @portal-app/db",
    "db:studio": "turbo run db:studio -F @portal-app/db",
    "db:generate": "turbo run db:generate -F @portal-app/db",
    "db:migrate": "turbo run db:migrate -F @portal-app/db",
    "db:start": "turbo run db:start -F @portal-app/db",
    "db:watch": "turbo run db:watch -F @portal-app/db",
    "db:stop": "turbo run db:stop -F @portal-app/db",
    "db:down": "turbo run db:down -F @portal-app/db",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@portal-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "@portal-app/config": "workspace:*",
    "@portal-app/db": "workspace:*",
    "@portal-app/shared-kernel": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "testcontainers": "^12.1.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.24.0"
}
