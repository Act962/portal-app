{
  "name": "portal-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @portal-app/db",
    "db:studio": "turbo run db:studio -F @portal-app/db",
    "db:generate": "turbo run db:generate -F @portal-app/db",
    "db:migrate": "turbo run db:migrate -F @portal-app/db",
    "db:start": "turbo run db:start -F @portal-app/db",
    "db:watch": "turbo run db:watch -F @portal-app/db",
    "db:stop": "turbo run db:stop -F @portal-app/db",
    "db:down": "turbo run db:down -F @portal-app/db",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@portal-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@portal-app/config": "workspace:*",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.24.0"
}
